[Unit]
Description=Qutie Studio LAN label editor
After=network.target bluetooth.service

[Service]
Type=simple
User=qutie
SupplementaryGroups=lp bluetooth
WorkingDirectory=/opt/qutie-web
Environment=QUTIE_TRANSPORT=bluetooth
EnvironmentFile=/etc/qutie-web.env
Environment=QUTIE_DATA=/var/lib/qutie-web
StateDirectory=qutie-web
ExecStart=/opt/qutie-web/.venv/bin/python -m uvicorn app:app --host 0.0.0.0 --port 8765 --workers 1
Restart=on-failure

[Install]
WantedBy=multi-user.target
